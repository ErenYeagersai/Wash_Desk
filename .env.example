# Supabase — copy these from your project's API settings
# Both values are safe to expose in browser code (RLS enforces access)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: only needed if a Cloudflare Worker endpoint is added for signed uploads
# NEVER put these in VITE_* variables — they must stay server-side only
# SUPABASE_SERVICE_ROLE_KEY=
# CLOUDINARY_API_SECRET=
